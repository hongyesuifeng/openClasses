{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "outDir": "./bin",
    "baseUrl": ".",
    "paths": {
      "cc": ["node_modules/cc"]
    }
  },
  "include": [
    "assets/scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "bin"
  ]
}
