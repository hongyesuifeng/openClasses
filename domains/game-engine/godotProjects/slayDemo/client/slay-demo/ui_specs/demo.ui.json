{
  "scene": "FrameworkDemo",
  "design_resolution": [1365, 768],
  "background": {
    "type": "Panel",
    "style": "panel_dark",
    "layout": { "preset": "full_rect" }
  },
  "children": [
    {
      "type": "Panel",
      "name": "TopBar",
      "style": "panel_dark",
      "layout": { "preset": "top_full", "margin": [0, 0, 0, 0], "height": 72 },
      "children": [
        {
          "type": "Label",
          "name": "TitleLabel",
          "text": "UI 框架 Demo",
          "style": "text_title",
          "layout": { "preset": "center", "size": [300, 48] }
        }
      ]
    },
    {
      "type": "VBoxContainer",
      "name": "CenterContent",
      "layout": { "preset": "center", "size": [400, 300] },
      "children": [
        {
          "type": "Label",
          "name": "DescLabel",
          "text": "框架验证界面",
          "style": "text_body",
          "layout": { "preset": "full_rect" }
        },
        {
          "type": "Panel",
          "name": "DemoPanel",
          "style": "panel_light",
          "layout": { "preset": "full_rect" }
        }
      ]
    },
    {
      "type": "Button",
      "name": "PrimaryBtn",
      "text": "主要按钮",
      "style": "btn_primary",
      "layout": { "preset": "bottom_center", "margin": [0, 0, 0, 40], "size": [240, 72] },
      "action": "demo.on_primary"
    },
    {
      "type": "Button",
      "name": "SecondaryBtn",
      "text": "次要按钮",
      "style": "btn_secondary",
      "layout": { "preset": "bottom_right", "margin": [0, 0, 40, 40], "size": [180, 60] },
      "action": "demo.on_secondary"
    }
  ]
}
