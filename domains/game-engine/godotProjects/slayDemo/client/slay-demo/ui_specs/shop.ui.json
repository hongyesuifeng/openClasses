{
  "scene": "ShopUI",
  "design_resolution": [1365, 768],
  "background": {
    "type": "TextureRect",
    "name": "Background",
    "asset": "backgrounds.shop",
    "stretch_mode": "keep_aspect_covered",
    "layout": { "preset": "full_rect" }
  },
  "children": [
    {
      "type": "HBoxContainer",
      "name": "ResourceBar",
      "layout": { "preset": "top_right", "size": [220, 44], "margin": [0, 18, 30, 0] }
    },
    {
      "type": "Control",
      "name": "MainRow",
      "layout": { "preset": "full_rect", "margin": [48, 64, 48, 40] },
      "children": [
        {
          "type": "Control",
          "name": "LeftPanel",
          "layout": { "preset": "left_full", "width": 860, "margin": [0, 0, 0, 0] },
          "children": [
            {
              "type": "Label",
              "name": "TitleLabel",
              "text": "流浪商人",
              "style": "text_title_pink",
              "layout": { "preset": "top_left", "size": [460, 84], "margin": [40, 40, 0, 0] }
            },
            {
              "type": "Label",
              "name": "SubtitleLabel",
              "text": "一个神秘的商人在路边摆摊，他看起来很会讨价还价。",
              "style": "text_caption",
              "layout": { "preset": "top_left", "size": [620, 62], "margin": [72, 132, 0, 0] }
            },
            {
              "type": "Label",
              "name": "StatusLabel",
              "text": "购买卡牌，或移除一张牌。",
              "style": "text_body",
              "layout": { "preset": "top_left", "size": [620, 44], "margin": [72, 196, 0, 0] }
            },
            {
              "type": "HBoxContainer",
              "name": "ContentRow",
              "layout": { "preset": "top_left", "size": [760, 340], "margin": [64, 260, 0, 0] }
            },
            {
              "type": "HBoxContainer",
              "name": "ButtonRow",
              "layout": { "preset": "bottom_left", "size": [430, 64], "margin": [220, 0, 0, 8] },
              "children": [
                {
                  "type": "Button",
                  "name": "RemoveButton",
                  "text": "删牌",
                  "style": "btn_primary",
                  "layout": { "preset": "full_rect" },
                  "action": "shop.on_remove_mode"
                },
                {
                  "type": "Button",
                  "name": "LeaveButton",
                  "text": "离开",
                  "style": "btn_action",
                  "layout": { "preset": "full_rect" },
                  "action": "shop.on_leave"
                }
              ]
            }
          ]
        },
        {
          "type": "Control",
          "name": "PortraitBox",
          "layout": { "preset": "right_full", "width": 390, "margin": [0, 42, 0, 0] },
          "children": [
            {
              "type": "Panel",
              "name": "PortraitPanel",
              "style": "panel_card",
              "layout": { "preset": "full_rect", "margin": [12, 0, 0, 0] },
              "children": [
                {
                  "type": "Control",
                  "name": "PortraitInner",
                  "layout": { "preset": "full_rect" },
                  "children": [
                    {
                      "type": "TextureRect",
                      "name": "PortraitImage",
                      "asset": "characters.merchant",
                      "stretch_mode": "keep_aspect_centered",
                      "layout": { "preset": "full_rect", "margin": [0, 0, 0, 80] }
                    },
                    {
                      "type": "Label",
                      "name": "MerchantName",
                      "text": "流浪商人",
                      "style": "text_body",
                      "layout": { "preset": "bottom_center", "size": [220, 48], "margin": [0, 0, 0, 24] }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
